# The FAF Daily answer service: resolves the daily/challenge answer and checks
# guesses server-side so the answer never reaches the browser. Runs the
# TypeScript directly with tsx (no build step). Internal-only — the web
# container's nginx proxies /api/* to it.
FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ENV PORT=8090
EXPOSE 8090
CMD ["npx", "tsx", "server/index.ts"]
